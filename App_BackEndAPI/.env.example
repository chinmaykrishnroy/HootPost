NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://192.168.1.13:8081,http://192.168.1.13:19006

MONGO_URI=mongodb://hootpost:hootpost@mongo:27017/hootpost?authSource=admin
REDIS_URL=redis://redis:6379

SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE_DAYS=30
MAX_ACTIVE_SESSIONS=10
SESSION_SECRET=replace-with-a-long-random-string

ADMIN_PASSWORD=replace-with-a-long-admin-secret

S3_ENDPOINT=http://192.168.1.13:9000
S3_REGION=auto
S3_BUCKET_NAME=hootpost
S3_ACCESS_KEY_ID=hootpost
S3_SECRET_ACCESS_KEY=hootpost-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://192.168.1.13:9000/hootpost

MAX_IMAGE_UPLOAD_MB=8
MAX_ATTACHMENT_UPLOAD_MB=32
